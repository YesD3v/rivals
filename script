        drawing.Thickness = 1.5
        drawing.Color = Color3.fromRGB(255, 255, 255)
        drawing.Transparency = 1
        drawing.Visible = false
        return drawing
    end)

    if success and result then
        tracerLines[player] = result
        return result
    end

    return nil
end

local function removeTracerLine(player)
