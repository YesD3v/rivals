local function normalizeTeamValue(value)
    if value == nil then
        return nil
    end

    local valueType = typeof(value)

    if valueType == "Instance" then
        return value
    end

    if valueType == "Color3" then
        return string.format(
            "color:%.4f:%.4f:%.4f",
            value.R,
            value.G,
            value.B
        )
    end

    if valueType == "BrickColor" then
        return "brick:" .. value.Name
    end

    if valueType == "string" then
        if value == "" then
            return nil
        end

        return "string:" .. value
    end

    if valueType == "number" then
        return "number:" .. tostring(value)
    end

    if valueType == "boolean" then
        return "boolean:" .. tostring(value)
    end

    return nil
end

local function isTeamName(name)
    if typeof(name) ~= "string" then
        return false
    end

    local lowered = string.lower(name)
    lowered = string.gsub(lowered, "[%s_%-]", "")

    return lowered == "team"
        or lowered == "teamid"
        or lowered == "teamidentifier"
        or lowered == "teamindex"
        or lowered == "teamcolor"
        or lowered == "teamcolour"
        or string.find(lowered, "teamid", 1, true) ~= nil
end

local function getTeamFromAttributes(container)
    if not container then
        return nil
    end

    local attributes = container:GetAttributes()

    for name, value in pairs(attributes) do
        if isTeamName(name) then
            local normalized = normalizeTeamValue(value)

            if normalized ~= nil then
                return normalized
            end
        end
    end

    return nil
end

local function getTeamFromValues(container)
    if not container then
        return nil
    end

    for _, object in ipairs(container:GetChildren()) do
        if isTeamName(object.Name) then
            if object:IsA("ObjectValue") then
                if object.Value then
                    return object.Value
                end
            elseif object:IsA("StringValue") then
                local normalized = normalizeTeamValue(object.Value)

                if normalized then
                    return normalized
                end
            elseif object:IsA("IntValue") or object:IsA("NumberValue") then
                local normalized = normalizeTeamValue(object.Value)

                if normalized then
                    return normalized
                end
            elseif object:IsA("Color3Value") then
                local normalized = normalizeTeamValue(object.Value)

                if normalized then
                    return normalized
                end
            elseif object:IsA("BrickColorValue") then
                local normalized = normalizeTeamValue(object.Value)

                if normalized then
                    return normalized
                end
            end
        end
    end

    return nil
end

local function getRivalsTeamSignature(player)
    if not player then
        return nil
    end

    local now = os.clock()

    if teamCache[player] ~= nil and teamCacheTime[player] and now - teamCacheTime[player] < TEAM_CACHE_DURATION then
        return teamCache[player]
    end

    local signature = nil

    if player.Team then
        signature = player.Team
    end

    if not signature then
        signature = getTeamFromAttributes(player)
    end

    if not signature then
        signature = getTeamFromValues(player)
    end

    if not signature and player.Character then
        signature = getTeamFromAttributes(player.Character)
    end

    if not signature and player.Character then
        signature = getTeamFromValues(player.Character)
    end

    if not signature and player.TeamColor then
        local colorName = player.TeamColor.Name

        if colorName and colorName ~= "Medium stone grey" then
            signature = "brick:" .. colorName
        end
    end

    teamCache[player] = signature
    teamCacheTime[player] = now

    return signature
end

local function clearTeamCache(player)
    teamCache[player] = nil
    teamCacheTime[player] = nil
end

