local SetControlsRemote

local function findControlsRemote()
    local ok, remote = pcall(function()
        return ReplicatedStorage:
            WaitForChild(
                "Remotes",
                10
            ):
            WaitForChild(
                "Replication",
                10
            ):
            WaitForChild(
                "Fighter",
                10
            ):
            WaitForChild(
                "SetControls",
                10
            )
    end)

    if ok
        and remote then

        SetControlsRemote =
            remote

        return true
    end

    return false
end

findControlsRemote()

local function spoofDevice(value)
    if not SetControlsRemote
        or not SetControlsRemote.Parent then

        if not findControlsRemote() then
            return false
        end
    end

    local ok = pcall(function()
        SetControlsRemote:FireServer(
            "MouseKeyboard"
        )

        task.wait(0.3)

        SetControlsRemote:FireServer(
            value
        )
    end)

    return ok
end

local function applySavedDevice()
    local savedDevice =
        Settings.DeviceSpoofer_Active

    if not Settings.DeviceSpoofer_Enabled
        or not savedDevice then

        return
    end

    task.spawn(function()
        if not game:IsLoaded() then
            game.Loaded:Wait()
        end

        task.wait(1)

        for i = 1, 15 do
            if not Settings.DeviceSpoofer_Enabled
                or Settings.DeviceSpoofer_Active
                    ~= savedDevice then

                return
            end

            if not SetControlsRemote
                or not SetControlsRemote.Parent then

                findControlsRemote()
            end

            spoofDevice(
                savedDevice
            )

            task.wait(1)
        end
    end)
end

