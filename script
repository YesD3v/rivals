local function startTriggerbotLoop()
    task.spawn(function()
        while true do
            if not Settings.Triggerbot_Enabled then
                releaseTrigger()
                task.wait(0.1)
                continue
            end

            if MenuFrame.Visible then
                releaseTrigger()
                task.wait(0.1)
                continue
            end

            local crosshair = getCrosshairPosition()
            local shouldFire = false

            for _, player in ipairs(getEnemies()) do
                local root = getCharacterPart(player, "HumanoidRootPart")

                if root then
                    local distance = (root.Position - Camera.CFrame.Position).Magnitude

                    if distance <= Settings.Triggerbot_MaxDistance then
                        local bodyParts = {
                            getCharacterPart(player, "Head"),
                            getCharacterPart(player, "UpperTorso"),
                            getCharacterPart(player, "LowerTorso"),
                            getCharacterPart(player, "Torso"),
                            getCharacterPart(player, "HumanoidRootPart"),
                        }

                        for _, part in ipairs(bodyParts) do
                            if part then
                                local screenPos, onScreen = worldToScreen(part.Position)

                                if screenPos and onScreen then
                                    if (screenPos - crosshair).Magnitude <= Settings.Triggerbot_FOVRadius then
                                        if isVisible(part) then
                                            shouldFire = true
                                            break
                                        end
                                    end
                                end
                            end
                        end
                    end
                end

                if shouldFire then
                    break
                end
            end

            if shouldFire then
                fireClick()
                task.wait(Settings.Triggerbot_Delay)
            else
                releaseTrigger()
                task.wait(0.05)
            end
        end
    end)
end

