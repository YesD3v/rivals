local function getTracerTarget(character, root)
    local head = character:FindFirstChild("Head")
    if head then
        return head.Position
    end
    return root.Position
end

local function updateTracer()
    if not Settings.ESP_Enabled or not Settings.ESP_Tracer or MenuFrame.Visible then
        hideTracerLines()
        return
    end

    local localCharacter = LocalPlayer.Character
    local localRoot = localCharacter and localCharacter:FindFirstChild("HumanoidRootPart")

    if not localRoot or not Camera then
        hideTracerLines()
        return
    end

    local mouse = LocalPlayer:GetMouse()
    local mouseHit = mouse.Hit

    if not mouseHit then
        hideTracerLines()
        return
    end

    local mousePosition = Camera:WorldToViewportPoint(mouseHit.Position)
    local origin = Vector2.new(mousePosition.X, mousePosition.Y)
    local seen = {}

    for _, player in ipairs(getEnemies()) do
        local character = player.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        local root = character and character:FindFirstChild("HumanoidRootPart")

        if humanoid and humanoid.Health > 0 and root then
            local distance = (localRoot.Position - root.Position).Magnitude

            if distance <= 1000 then
                local targetPos = getTracerTarget(character, root)
                local screenPosition = Camera:WorldToViewportPoint(targetPos)

                if screenPosition.Z > 0 then
                    local line = getTracerLine(player)

                    if line then
                        line.From = origin
                        line.To = Vector2.new(
                            screenPosition.X,
                            screenPosition.Y
                        )
                        line.Visible = true
                        seen[player] = true
                    end
                end
            end
        end
    end

    for player, line in pairs(tracerLines) do
        if not seen[player] then
            line.Visible = false
        end
    end
end

local lockedTarget = nil

local function getAimTarget()
    local crosshair = getCrosshairPosition()

    if lockedTarget then
        if not isEnemy(lockedTarget) then
            lockedTarget = nil
        else
            local character = lockedTarget.Character
            local head = character and character:FindFirstChild("Head")
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")

            if head and humanoid and humanoid.Health > 0 then
                if Settings.Aimbot_WallCheck and not isVisible(head) then
                    lockedTarget = nil
                else
                    return head
                end
            else
                lockedTarget = nil
            end
        end
    end

    local bestPlayer = nil
    local bestDist = math.huge

    for _, player in ipairs(getEnemies()) do
        local character = player.Character

        if not character then
            continue
        end

        local head = character:FindFirstChild("Head")

        if head then
            local screenPos, onScreen = worldToScreen(head.Position)

            if screenPos and onScreen then
                local dist = (screenPos - crosshair).Magnitude

                if dist <= Settings.Aimbot_FOVRadius then
                    if Settings.Aimbot_WallCheck and not isVisible(head) then
                        continue
                    end

                    if dist < bestDist then
                        bestDist = dist
                        bestPlayer = player
                    end
                end
            end
        end
    end

    if bestPlayer then
        lockedTarget = bestPlayer
        return bestPlayer.Character:FindFirstChild("Head")
    end

    return nil
end

local function forceAimAtHead(head)
    if not head or not head.Parent or not Camera then
        return false
    end

    local character = LocalPlayer.Character
    if not character then return false end

    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return false end

    local targetPosition = head.Position
    local cameraPosition = Camera.CFrame.Position

    Camera.CFrame = CFrame.lookAt(
        cameraPosition,
        targetPosition,
        Vector3.new(0, 1, 0)
    )

    local lookAtCF = CFrame.lookAt(rootPart.Position, targetPosition, Vector3.new(0, 1, 0))
    rootPart.CFrame = lookAtCF

    return true
end

local function updateLockedBody()
    if not Settings.Aimbot_Enabled or not lockedTarget then
        return
    end

    if not isEnemy(lockedTarget) then
        lockedTarget = nil
        return
    end

    local character = lockedTarget.Character
    local head = character and character:FindFirstChild("Head")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")

    if not character or not head or not humanoid or humanoid.Health <= 0 then
        lockedTarget = nil
        return
    end

    if Settings.Aimbot_WallCheck and not isVisible(head) then
        lockedTarget = nil
        return
    end

    forceAimAtHead(head)
end

